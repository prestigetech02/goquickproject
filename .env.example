# Laravel API — use your PC's LAN IP (not 127.0.0.1) so phones on Wi‑Fi can reach it
VITE_API_BASE_URL=http://192.168.x.x:8000/api/v1

# Paystack public key (test or live)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App store links (shown to runners who land on web)
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.goquick.app
VITE_APP_STORE_URL=https://apps.apple.com/app/goquick

# Marketing site
VITE_LANDING_URL=https://goquickapp.com.ng

# Mapbox GL JS — public token only (pk.…). Never put the secret server token here.
VITE_MAPBOX_ACCESS_TOKEN=

# Realtime: must match backend BROADCAST_CONNECTION
# Prefer reverb (self-hosted). Use pusher only if you intentionally use Pusher.com.
VITE_BROADCAST_DRIVER=reverb

# Pusher.com — used when VITE_BROADCAST_DRIVER=pusher
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1

# Laravel Reverb — used when VITE_BROADCAST_DRIVER=reverb
VITE_REVERB_APP_KEY=demo_app_key_123456
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Firebase web push (requester browser notifications) — from Firebase Console → Project settings → Web app
# Also add a Web app in the goquick-2fd2c project and copy the Web Push certificate (VAPID key).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=goquick-2fd2c.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=goquick-2fd2c
VITE_FIREBASE_MESSAGING_SENDER_ID=286947899700
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
